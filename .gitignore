# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code generated
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/

# ---------------------------------------------------------------
# NativeRemesher benchmark artefacts
# ---------------------------------------------------------------
# Benchmark result CSV/markdown ARE committed on purpose: every metric
# movement must be attributable to a commit. Only the external mesh corpus
# and scratch runs are ignored.
/Benchmarks/scratch/
/Benchmarks/*.tmp

# External benchmark corpus — meshes are never committed, only the manifest.
# Default location is <project>/../QuadremeshCorpus, but ignore an in-tree
# copy too in case someone puts it here.
/QuadremeshCorpus/
/Benchmarks/corpus/

# Test-run and probe artefacts. Kept out of the repo deliberately: the CSVs under Benchmarks/
# are the committed record, and a stray results.xml next to them invites reading a one-off run
# as if it were the baseline.
results*.xml
editor-*.log
probe*.log

# Large or regenerable assets, kept out of the repo.
#
# ccnb/ is a user-supplied 84 MB scan used for real-world testing — input data, not project
# source. Output/ holds tool results. TestMeshes/ is generated by Editor/TestMeshSpawner.cs and
# is reproducible from code, so committing 4.7 MB of it buys nothing.
/Assets/ccnb/
/Assets/ccnb.meta
/Assets/NativeRemesher/Output/
/Assets/NativeRemesher/Output.meta
/Assets/NativeRemesher/TestMeshes/
/Assets/NativeRemesher/TestMeshes.meta
/Assets/QuadRemesher/Output/
/Assets/QuadRemesher/Output.meta
bench*.log
test-run.log
diag-*.log

# Reference-comparison meshes: derived from Assets/ccnb FBX pair, 56 MB, regenerable
Benchmarks/reference/*.obj
refcmp.log
bench.log
dec.log
tests.log

# ---------------------------------------------------------------
# Headless measurement project — Headless/
# ---------------------------------------------------------------
# A second Unity project inside this one, because Unity refuses to open a project another
# instance already holds, which made every benchmark a request to close the editor. tools/
# sync-headless.sh mirrors Runtime/Benchmark/Tests into it.
#
# What IS committed: ProjectSettings/, Packages/manifest.json and README.md — the scaffolding, so
# a fresh clone runs the sync once and has a working measurement project.
#
# What is NOT: everything the sync or a run produces. Headless/Assets/ in particular is a
# generated copy of Assets/NativeRemesher/, and committing it would give this repo two copies of
# the same code, free to drift, with nothing saying which one is real.
/Headless/Assets/
/Headless/UserSettings/
/Headless/*.log
/Headless/*.xml

# Benchmark outputs land here first and are copied into Benchmarks/ with the commit that caused
# them. Keeping both would double every row and make it ambiguous which was the committed record.
/Headless/Benchmarks/*.csv
/Headless/Benchmarks/*.md
/Headless/Benchmarks/reference/

# Derived from the gitignored scan: large, and regenerated by Benchmark/CharacterExport.
Benchmarks/reference/*.fbx

# Python bytecode from the analysis scripts.
__pycache__/
